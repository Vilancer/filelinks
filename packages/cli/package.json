{
  "name": "@vilancer/filelinks",
  "version": "1.0.3",
  "description": "CLI for filelinks: check staged git file-links and optionally run Cursor AI agents (--run-agents). filelinks add creates config if missing. Install with @vilancer/filelinks-core.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "filelinks": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "filelinks",
    "cli",
    "git",
    "staged",
    "file-relationships",
    "ai",
    "cursor",
    "agents",
    "monorepo",
    "devtools"
  ],
  "homepage": "https://github.com/Vilancer/filelinks#readme",
  "bugs": {
    "url": "https://github.com/Vilancer/filelinks/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vilancer/filelinks.git",
    "directory": "packages/cli"
  },
  "license": "ISC",
  "dependencies": {
    "@vilancer/filelinks-core": "workspace:*",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nx/vite": "22.6.4",
    "@types/react": "^18.3.28",
    "ink-testing-library": "^4.0.0",
    "vitest": "~4.1.0"
  }
